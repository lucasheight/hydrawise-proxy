  "author": "Lynden Garrett",
  "type": "commonjs",
  "main": "server.js",
  "config": {
    "image": "registry.garit.au/hydrawise-proxy",
    "platform": "linux/amd64"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "docker:build": "docker build --platform $npm_package_config_platform -t $npm_package_config_image:$npm_package_version -t $npm_package_config_image:latest .",
    "docker:push": "docker push $npm_package_config_image:$npm_package_version && docker push $npm_package_config_image:latest",
    "deploy": "npm run docker:build && npm run docker:push"
  }
}
