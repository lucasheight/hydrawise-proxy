# Copy to .env and fill in. .env is gitignored — keep the real key out of source.
API_KEY=

# Seconds each zone runs on POST /start. 1800 = 30 minutes per zone.
RUN_SECONDS=1800

# Sentinel that tells setzone.php to honour the custom duration.
RUN_PERIOD_ID=999

# Who can reach the proxy. 0.0.0.0 = reachable from the LAN (no request auth,
# so anyone who can route here can start the irrigation). 127.0.0.1 = host only.
BIND_ADDR=0.0.0.0

# Pin a released version instead of tracking latest. Also how you roll back.
# TAG=1.0.0

# MQTT (optional). Unset means no broker connection is attempted at all.
# Points at a broker you already run — none is bundled.
# MQTT_URL=mqtt://broker.lan:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Topic root. Default: hydrawise
# MQTT_PREFIX=hydrawise

# Home Assistant discovery. Set to 0 to publish state without creating entities.
# MQTT_DISCOVERY=1
# MQTT_DISCOVERY_PREFIX=homeassistant
